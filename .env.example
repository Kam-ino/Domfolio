# Copy this file to ".env" (same folder) and fill in your key, then restart `npm start`.
#
# Web3Forms powers the "Send a Raven" contact form (src/components/Contact.js).
# Get a FREE access key — it's emailed to you instantly, no dashboard required:
#   https://web3forms.com
# Until this is set, the form falls back to opening the visitor's mail client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
REACT_APP_WEB3FORMS_KEY=
